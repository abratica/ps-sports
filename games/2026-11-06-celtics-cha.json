    "sections": [
      {
        "label": "1st quarter",
        "score": "BOS 40, CHA 20",
        "text": "Tatum and Paul George opened with back-to-back threes, and Boston led 16–4 early. Tatum had 18 points with three threes, tying his career high for an opening quarter, and Boston went 9-of-17 from deep while Charlotte made 2 of 14."
      },
      {
        "label": "2nd quarter",
        "score": "BOS 70, CHA 39",
        "text": "Boston led 53–25 with 6:34 left and 62–31 later in the quarter. Brandon Miller left with right groin soreness after scoring 8 on 3-of-10 shooting and did not return. The Celtics made 17 of 31 threes in the half, tying a franchise record, and Derrick White had all 18 of his points by the break."
      },
      {
        "label": "3rd quarter",
        "score": "BOS 96, CHA 57",
        "text": "Neemias Queta scored on a hook and a one-handed alley-oop from Tatum, and Jordan Walsh finished an and-one dunk off a Tatum pass. Tatum sat for good in the final minute of the quarter after 29 minutes."
      },
      {
        "label": "4th quarter",
        "score": "Final: BOS 119, CHA 80",
        "text": "Payton Pritchard hit threes in the fourth on the way to 12 points. Boston finished 24-of-44 from three; Charlotte shot 29.3% and lost its sixth straight."
      }
