    "sections": [
      {
        "label": "1st period",
        "score": "BOS 1, VGK 0",
        "text": "At 7:23, seconds after Carter Hart stopped Nikita Zadorov in the slot, Elias Lindholm collected the puck behind the net and fed James Hagens for his sixth goal, the most among NHL rookies. Boston has scored first in six of its last seven games."
      },
      {
        "label": "2nd period",
        "score": "BOS 2, VGK 1",
        "text": "Braeden Bowman got a five-minute major and a game misconduct at 2:49 for an elbow to Matthew Poitras's face, and Morgan Geekie scored 33 seconds into the major, from Pavel Zacha and Pastrnak, to end Boston's 0-for-10 power-play skid. Poitras returned to the bench but never took another shift. Mark Stone cut it to 2–1 on a power play at 14:58, putting in the rebound of a Tomas Hertl shot; Charlie McAvoy, who took three penalties, was also called for arguing with the officials after the goal."
      },
      {
        "label": "3rd period",
        "score": "BOS 2, VGK 2",
        "text": "Trevor Connelly tied it at 7:23, banking Noah Hanifin's feed from behind the net off Swayman."
      },
      {
        "label": "Overtime",
        "score": "BOS 2, VGK 2",
        "text": "No goals in overtime, sending Boston to its first shootout of the season."
      },
      {
        "label": "Shootout",
        "score": "Final: BOS 3, VGK 2 (SO)",
        "text": "Swayman stopped Connelly, Jack Eichel and Mitch Marner, and Pastrnak beat Hart in the third round for the only goal."
      }
    ],
