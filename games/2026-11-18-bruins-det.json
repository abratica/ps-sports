    "sections": [
      {
        "label": "1st period",
        "score": "DET 1, BOS 0",
        "text": "Boston carried much of the play, but Lucas Raymond finished a 2-on-1 with Andrew Copp at 16:58 after a Mason Lohrei pinch, and the Bruins trailed after the first for a fourth straight game."
      },
      {
        "label": "2nd period",
        "score": "BOS 2, DET 1",
        "text": "JJ Peterka tied it at 2:49, his sixth, off a Lohrei stretch pass after Casey Mittelstadt won a board battle. Pavel Zacha put Boston ahead on the power play at 11:48, knocking in the rebound of a David Pastrnak shot, for the Bruins' first lead since Nov. 8."
      },
      {
        "label": "3rd period",
        "score": "Final: BOS 4, DET 1",
        "text": "Pastrnak scored his 10th at 5:11 on an odd-man rush set up by Lohrei, and Mittelstadt hit the empty net with 55 seconds left."
      }
    ],
